{
    "name": "vanqard/json-middleware",
    "description": "A simple way to send json output from a php framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thunder Raven-Stoker",
            "email": "thunder@vanqard.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "vanqard/common": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Vanqard\\JsonMiddleware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vanqard\\JsonMiddleware\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:vanqard/common.git"
        }
    ]
}
